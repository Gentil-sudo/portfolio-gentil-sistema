# Copie para .env.local e preencha

# Chave do Web3Forms (formulário de contato) — gere em https://web3forms.com
VITE_WEB3FORMS_KEY=

# WakaTime (só o servidor lê; sem VITE_ de propósito)
# App OAuth criado em https://wakatime.com/apps
# (Redirect URI: http://localhost:8787/callback)
WAKATIME_APP_ID=
WAKATIME_APP_SECRET=

# Gerados pelo npm run wakatime:oauth
WAKATIME_ACCESS_TOKEN=
WAKATIME_REFRESH_TOKEN=

# Opcional: sem token, usa o perfil público do WakaTime
# WAKATIME_USERNAME=

# Opcional: projetos que aparecem pelo nome no "Codando agora" (separados por vírgula)
# WAKATIME_PUBLIC_PROJECTS=
